[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
default-time-zone    = '+00:00'
max_connections      = 100
wait_timeout         = 600
interactive_timeout  = 600
# Bounded memory for a local environment
innodb_buffer_pool_size = 256M
performance_schema      = OFF
local_infile            = OFF
skip-name-resolve
