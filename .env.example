# Copied to .env by ./start.sh; "__GENERATE__" values are replaced with random secrets.

# Ports published on the host (80/443 are used by the system nginx)
HTTP_PORT=8088
HTTPS_PORT=8443
MAILPIT_PORT=8025

# MySQL
MYSQL_DATABASE=toolapp
MYSQL_USER=toolapp
MYSQL_PASSWORD=__GENERATE__
MYSQL_ROOT_PASSWORD=__GENERATE__

# Redis
REDIS_PASSWORD=__GENERATE__

# Auth
JWT_SECRET=__GENERATE__

# HSTS: leave empty on localhost (otherwise the browser forces HTTPS on ALL your local projects).
# With a real domain: NGINX_HSTS=max-age=63072000; includeSubDomains
NGINX_HSTS=
