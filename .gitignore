# --- Internal documentation (plans, notes): local only ---
docs/

# --- Secrets (start.sh generates .env from .env.example) ---
.env
.env.*
!.env.example

# --- Development TLS certificates (generated by start.sh; the folders are kept) ---
nginx/ca/*
!nginx/ca/.gitkeep
nginx/certs/*
!nginx/certs/.gitkeep
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.coverage
htmlcov/

# --- Node / Next.js (frontend/.gitignore covers the rest) ---
node_modules/
.next/
coverage/
*.tsbuildinfo

# --- Editors and OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
*.swp
